#include system/draw_system.lua
#include system/hitbox_system.lua
#include system/hurtbox_system.lua
#include system/player_death_system.lua
#include system/room_change_system.lua
#include system/skull_block_system.lua
#include system/spike_system.lua
#include system/switch_system.lua
#include system/update_system.lua
#include ui/title_screen.lua
#include data.lua

START_TEXT = {
	"aN UNFATHOMABLE TREASURE",
	"LIES BELOW IN tARTAROS,",
	"THE eTERNAL pRISON."
}

function _init()
	cartdata("eggbert_tartaros")
	load_room_data()
	music(AREA_MUSIC["tyrfing"])
end

function _update()
	if state == "play" then
		update_system()
		body_system_run()
		hitbox_system_run()
		spike_system_run()
		hurtbox_system_run()
		skull_block_run()
		switch_system_run()
		room_change_system()
		player_death_system_run()
		if state_flags[STATE_FLAG_TYPHON_DEAD] then
			state = "title"
			music(AREA_MUSIC["tyrfing"])
		end
	elseif state == "player_dead" then
		if btnp(5) then
			state = "play"
			load_game()
		else
			update_system()
		end
	elseif state == "title" then
		if btnp(2) then
			menu_index = max(menu_index - 1, 1)
		elseif btnp(3) then
			menu_index = min(menu_index + 1, 2)
		elseif btnp(5) then
			if menu_index == 1 then
				new_game()
				load_game()
				state = "play"
				text_box_content = START_TEXT
			elseif menu_index == 2 then
				load_game()
				state = "play"
			end
		end
	end
end

function _draw()
	cls()
	if state == "title" then
		title_screen_draw()
	else
		draw_system_run()
	end
end

