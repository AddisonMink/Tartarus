#include system/body_system.lua
#include system/draw_system.lua
#include system/hitbox_system.lua
#include system/hurtbox_system.lua
#include system/player_death_system.lua
#include system/room_change_system.lua
#include system/skull_block_system.lua
#include system/spike_system.lua
#include system/update_system.lua
#include data.lua

function _init()
	load_room_data()
	load_game()
	--state_flags[STATE_FLAG_SWORD] = true
	--state_flags[STATE_FLAG_PICKAXE] = true
	--state_flags[STATE_FLAG_MAGIC_STONE] = true
	--state_flags[STATE_FLAG_RED_SWORD] = true
	--state_flags[STATE_FLAG_MAGIC_WAND] = true
	--state_flags[STATE_FLAG_HEART] = true
	--state_flags[STATE_FLAG_RED_HEART] = true
end

function _update()
	if state == "play" then
		update_system()
		body_system_run()
		hitbox_system_run()
		spike_system_run()
		hurtbox_system_run()
		skull_block_run()
		room_change_system()
		player_death_system_run()
		if state_flags[STATE_FLAG_SQUID_1] then
			state = "win"
			text_box_content = {
				"eND OF BETA!",
				"THANK YOU FOR PLAYING!"
			}
		end
	elseif state == "player_dead" then
		if btnp(5) then
			state = "play"
			load_game()
		else
			update_system()
		end
	end
end

function _draw()
	cls()
	draw_system_run()
end

