pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
#include global.lua
#include util/misc.lua
#include component/body.lua
#include component/hitbox.lua
#include component/hurtbox.lua
#include entity/bat.lua
#include entity/checkpoint.lua
#include entity/devil_fireball.lua
#include entity/devil.lua
#include entity/dragon_fire.lua
#include entity/dragon.lua
#include entity/fireball_spawner.lua
#include entity/fireball.lua
#include entity/giant.lua
